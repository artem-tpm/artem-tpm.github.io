---
---

<section id="top" class="relative flex min-h-screen items-center px-6 pt-16 overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(60rem 30rem at 85% -10%, rgba(15,61,104,0.06), transparent 60%), radial-gradient(50rem 25rem at -10% 30%, rgba(169,121,31,0.06), transparent 60%);"
  ></div>
  <div class="orb-field">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>
  <div class="mx-auto max-w-6xl w-full">
    <span class="eyebrow inline-block text-xs font-semibold uppercase text-[#0f3d68] bg-[#0f3d68]/[0.06] rounded-full px-3 py-1 mb-6">
      Technical Program Manager
    </span>
    <h1 class="font-serif-heading text-4xl sm:text-6xl md:text-7xl font-medium tracking-tight text-[#111827] leading-[1.08]">
      Turning complex programs<br class="hidden sm:block" />
      into <span class="text-accent-gradient">predictable outcomes.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-[#5b6472] leading-relaxed">
      20+ years in IT, spanning a shift from Network Engineer to Delivery
      Manager in a global software company. Skilled in navigating diverse
      international environments, with a strong understanding of
      cross-cultural communication.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="btn-shine rounded-md bg-[#0f3d68] text-white px-6 py-3 text-sm font-medium shadow-[0_12px_24px_-10px_rgba(15,61,104,0.55)] hover:bg-[#0c3255] transition-colors"
      >
        View track record
      </a>
      <a
        href="#contact"
        class="rounded-md border border-[#d4d9e2] px-6 py-3 text-sm font-medium text-[#111827] hover:border-[#0f3d68] hover:text-[#0f3d68] transition-colors"
      >
        Schedule a conversation
      </a>
    </div>
  </div>
</section>
