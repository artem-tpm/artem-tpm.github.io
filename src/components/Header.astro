---
const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#courses", label: "Courses" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-white/5 bg-[#08090d]/70 backdrop-blur-md">
  <nav class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="#top" class="font-semibold tracking-tight text-white/90">
      artem<span class="text-gradient">.tpm</span>
    </a>
    <ul class="hidden sm:flex items-center gap-8 text-sm text-white/60">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="#contact"
      class="hidden sm:inline-flex items-center gap-2 rounded-full border border-white/10 px-4 py-1.5 text-sm text-white/80 hover:border-cyan-300/40 hover:text-white transition-colors"
    >
      Get in touch
    </a>
  </nav>
</header>
