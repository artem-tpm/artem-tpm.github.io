---
const links = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#courses", label: "Courses" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-[#e3e6ec] bg-white/85 backdrop-blur-md">
  <nav class="mx-auto max-w-6xl px-6 h-16 flex items-center justify-between">
    <a href="#top" class="font-serif-heading text-lg tracking-tight text-[#111827]">
      Artem <span class="text-[#0f3d68]">— TPM</span>
    </a>
    <ul class="hidden sm:flex items-center gap-8 text-sm text-[#5b6472]">
      {links.map((link) => (
        <li>
          <a href={link.href} class="hover:text-[#111827] transition-colors">{link.label}</a>
        </li>
      ))}
    </ul>
    <a
      href="#contact"
      class="btn-shine hidden sm:inline-flex items-center gap-2 rounded-md bg-[#0f3d68] px-4 py-2 text-sm font-medium text-white hover:bg-[#0c3255] transition-colors"
    >
      Get in touch
    </a>
  </nav>
</header>
