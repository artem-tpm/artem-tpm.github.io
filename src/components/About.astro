---
const stats = [
  { value: "20+", label: "years in IT & delivery" },
  { value: "6", label: "leadership roles across telecom, gaming & healthtech" },
  { value: "20+", label: "professional certifications" },
];
---

<section id="about" class="px-6 py-28">
  <div class="mx-auto max-w-6xl grid gap-12 md:grid-cols-5 md:gap-16">
    <div class="reveal md:col-span-3">
      <h2 class="eyebrow text-xs font-semibold uppercase text-[#a9791f] mb-3">About</h2>
      <p class="font-serif-heading text-2xl sm:text-3xl text-[#111827] leading-snug">
        IT professional with over 20 years of experience, transitioning from
        Network Engineer to Delivery Leader in global software and healthtech
        companies.
      </p>
      <p class="mt-6 text-[#5b6472] leading-relaxed">
        Skilled in navigating diverse international environments, with a
        strong understanding of cross-cultural communication. A dedicated
        team player, consistently delivering high-quality results with
        responsibility and precision in dynamic environments. Based in
        Warsaw, Poland.
      </p>
    </div>
    <div class="reveal md:col-span-2 grid grid-cols-3 gap-4 content-start sm:grid-cols-1 sm:gap-6">
      {stats.map((stat) => (
        <div class="card-elevate card-sheen spotlight rounded-xl border border-[#e3e6ec] bg-white p-5">
          <div class="font-serif-heading text-3xl text-[#0f3d68]">{stat.value}</div>
          <div class="mt-1 text-sm text-[#5b6472]">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
