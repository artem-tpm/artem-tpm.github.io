---
const email = "artem_tpm@protonmail.com";
const linkedin = "https://linkedin.com/in/artem-zheleznyakov";
---

<section id="contact" class="relative px-6 py-28 overflow-hidden">
  <div class="orb-field">
    <span class="orb orb-1" style="opacity:0.6"></span>
    <span class="orb orb-2" style="opacity:0.6"></span>
  </div>
  <div class="reveal card-sheen spotlight mx-auto max-w-6xl rounded-2xl border border-[#e3e6ec] bg-white px-8 py-16 text-center sm:px-16 shadow-[0_30px_60px_-30px_rgba(17,24,39,0.18)]">
    <h2 class="eyebrow text-xs font-semibold uppercase text-[#a9791f] mb-3">Contact</h2>
    <h3 class="font-serif-heading text-2xl sm:text-4xl text-[#111827]">Get in touch.</h3>
    <p class="mt-4 text-[#5b6472] max-w-xl mx-auto">
      This page is a look at the work and impact behind my career. If
      something here resonates, I'd be glad to hear from you.
    </p>
    <p class="mt-2 text-sm text-[#5b6472] max-w-xl mx-auto">
      Recommendations from colleagues and managers are available on my{" "}
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-[#0f3d68] hover:underline">
        LinkedIn
      </a>.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`mailto:${email}`}
        class="btn-shine rounded-md bg-[#0f3d68] text-white px-6 py-3 text-sm font-medium shadow-[0_12px_24px_-10px_rgba(15,61,104,0.55)] hover:bg-[#0c3255] transition-colors"
      >
        Email me
      </a>
      <button
        id="copy-email"
        type="button"
        data-email={email}
        class="rounded-md border border-[#d4d9e2] px-6 py-3 text-sm font-medium text-[#111827] hover:border-[#0f3d68] hover:text-[#0f3d68] transition-colors"
      >
        Copy email
      </button>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-[#d4d9e2] px-6 py-3 text-sm font-medium text-[#111827] hover:border-[#0f3d68] hover:text-[#0f3d68] transition-colors"
      >
        LinkedIn
      </a>
    </div>
  </div>
</section>

<script>
  const button = document.getElementById("copy-email");
  button?.addEventListener("click", async () => {
    const email = button.getAttribute("data-email") ?? "";
    try {
      await navigator.clipboard.writeText(email);
      const original = button.textContent;
      button.textContent = "Copied!";
      setTimeout(() => {
        button.textContent = original;
      }, 1500);
    } catch {
      // Clipboard API unavailable — the mailto link above still works.
    }
  });
</script>
