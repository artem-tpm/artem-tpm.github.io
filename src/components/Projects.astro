  {
    title: "Platform Migration Program",
    period: "2025",
    description:
      "Placeholder — describe a completed project: the goal, your role as TPM, the teams involved, and the measurable outcome.",
    tags: ["Program Mgmt", "Cloud Migration", "Cross-team"],
  },
  {
    title: "ML Feature Rollout",
    period: "2024",
    description:
      "Placeholder — a program you drove end-to-end, from scoping through launch, including how you handled risk and dependencies.",
    tags: ["Roadmapping", "ML/AI", "Stakeholder Mgmt"],
  },
  {
    title: "Internal Developer Tooling",
    period: "2023",
    description:
      "Placeholder — a project that improved engineering velocity or process, with a quantified before/after result.",
    tags: ["DevEx", "Process", "Automation"],
