<section id="projects" class="mesh-bg px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="reveal eyebrow text-xs font-semibold uppercase text-[#a9791f] mb-3">Track Record</h2>
    <h3 class="reveal font-serif-heading text-2xl sm:text-3xl text-[#111827] mb-12">Experience</h3>
    <div class="grid gap-6 sm:grid-cols-2">
      {projects.map((project) => (
        <div class="reveal card-elevate card-sheen spotlight rounded-xl border border-[#e3e6ec] bg-white p-6">
          <div class="flex items-baseline justify-between">
            <h4 class="text-lg font-medium text-[#111827]">{project.title}</h4>
            <span class="text-xs text-[#5b6472]">{project.period}</span>
          </div>
          <p class="mt-3 text-sm text-[#5b6472] leading-relaxed">{project.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full border border-[#d4d9e2] px-3 py-1 text-xs text-[#5b6472]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
