---
const courses = [
  { name: "Technical Program Management Certificate", org: "Placeholder Institution", year: "2024" },
  { name: "Advanced Cloud Architecture", org: "Placeholder Institution", year: "2023" },
  { name: "Agile & Scrum Leadership", org: "Placeholder Institution", year: "2022" },
  { name: "Data Structures & Algorithms", org: "Placeholder Institution", year: "2021" },
];
---

<section id="courses" class="px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="reveal text-sm font-mono text-cyan-300/80 mb-3">03 — Courses</h2>
    <h3 class="reveal text-2xl sm:text-3xl text-white/90 mb-12">Courses &amp; certifications</h3>
    <ul class="reveal divide-y divide-white/10 rounded-2xl border border-white/10 bg-white/[0.02]">
      {courses.map((course) => (
        <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 px-6 py-5">
          <div>
            <p class="text-white/85">{course.name}</p>
            <p class="text-sm text-white/45">{course.org}</p>
          </div>
          <span class="text-sm font-mono text-white/40">{course.year}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
