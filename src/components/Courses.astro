<section id="courses" class="px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="reveal eyebrow text-xs font-semibold uppercase text-[#a9791f] mb-3">Education</h2>
    <h3 class="reveal font-serif-heading text-2xl sm:text-3xl text-[#111827] mb-12">Education &amp; certifications</h3>

    <h4 class="reveal text-sm text-[#5b6472] mb-4">Education</h4>
    <ul class="reveal card-sheen divide-y divide-[#e3e6ec] rounded-xl border border-[#e3e6ec] bg-white shadow-[0_20px_40px_-30px_rgba(17,24,39,0.15)] mb-12">
      {education.map((item) => (
        <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 px-6 py-5 transition-colors hover:bg-[#f7f8fa]">
          <div>
            <p class="text-[#111827]">{item.name}</p>
            <p class="text-sm text-[#5b6472]">{item.org}</p>
          </div>
          <span class="text-sm text-[#5b6472]">{item.year}</span>
        </li>
      ))}
    </ul>

    <h4 class="reveal text-sm text-[#5b6472] mb-4">Certifications</h4>
    <ul class="reveal card-sheen divide-y divide-[#e3e6ec] rounded-xl border border-[#e3e6ec] bg-white shadow-[0_20px_40px_-30px_rgba(17,24,39,0.15)] max-h-[26rem] overflow-y-auto">
      {certifications.map((item) => (
        <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 px-6 py-4 transition-colors hover:bg-[#f7f8fa]">
          <div>
            <p class="text-[#111827]">{item.name}</p>
            <p class="text-sm text-[#5b6472]">{item.org}</p>
          </div>
          <span class="text-sm text-[#5b6472] whitespace-nowrap">
            {item.year}{item.hours ? ` · ${item.hours}` : ""}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
