---
const courses = [
  { name: "Technical Program Management Certificate", org: "Placeholder Institution", year: "2024" },
  { name: "Advanced Cloud Architecture", org: "Placeholder Institution", year: "2023" },
  { name: "Agile & Scrum Leadership", org: "Placeholder Institution", year: "2022" },
  { name: "Data Structures & Algorithms", org: "Placeholder Institution", year: "2021" },
];
---

<section id="courses" class="px-6 py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="reveal eyebrow text-xs font-semibold uppercase text-[#a9791f] mb-3">Education</h2>
    <h3 class="reveal font-serif-heading text-2xl sm:text-3xl text-[#111827] mb-12">Courses &amp; certifications</h3>
    <ul class="reveal card-sheen divide-y divide-[#e3e6ec] rounded-xl border border-[#e3e6ec] bg-white shadow-[0_20px_40px_-30px_rgba(17,24,39,0.15)]">
      {courses.map((course) => (
        <li class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 px-6 py-5 transition-colors hover:bg-[#f7f8fa]">
          <div>
            <p class="text-[#111827]">{course.name}</p>
            <p class="text-sm text-[#5b6472]">{course.org}</p>
          </div>
          <span class="text-sm text-[#5b6472]">{course.year}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
